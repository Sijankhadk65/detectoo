meta {
  name: Create Reminder
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/reminder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Water the basil",
    "time": "2026-04-18T08:00:00Z",
    "icon_code_point": 59573,
    "plant_id": 3
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("reminder_id", res.body.id);
  }
}
