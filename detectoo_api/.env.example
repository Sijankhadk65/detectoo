# ============================================================================
# detectoo_api — example environment file
# Copy this to src/.env and adjust values for your local setup.
# ============================================================================

# ------------- app -------------
APP_NAME="Detectoo API"
APP_DESCRIPTION="Detectoo backend (development scaffold)"
APP_VERSION="0.1.0"
CONTACT_NAME="Sijan Khadka"
CONTACT_EMAIL="anshukhadka44@gmail.com"
LICENSE_NAME="MIT"

# ------------- database -------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="detectoo"
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"
POSTGRES_SYNC_PREFIX="postgresql://"

# ------------- crypt -------------
# Generate a fresh secret with: openssl rand -hex 32
SECRET_KEY="change-me-please-openssl-rand-hex-32"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------- first superuser -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Str1ngst!"

# ------------- CORS -------------
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ------------- storage -------------
SERVER_URL="http://localhost:8000"
UPLOADS_DIR="/app/uploads"

# ------------- environment -------------
ENVIRONMENT="local"
