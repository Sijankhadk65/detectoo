# Production environment — copy to .env.prod and fill in real values
APP_NAME="Detectoo API"
APP_VERSION="0.1.0"

# Postgres (overridden at runtime by docker-compose.prod.yml for POSTGRES_SERVER/PORT)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=detectoo_prod

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed user
ADMIN_NAME=admin
ADMIN_EMAIL=admin@detectoo.tech
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI
ANTHROPIC_API_KEY=
