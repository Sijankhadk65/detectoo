meta {
  name: Create Scan
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "plant_name": "Basil",
    "species": "Ocimum basilicum",
    "plant_id": {{plant_id}},
    "is_healthy": false,
    "image_url": "https://example.com/scan.jpg",
    "issues": [
      {
        "name": "Leaf Spot",
        "description": "Dark circular spots on lower leaves.",
        "severity": "Moderate",
        "confidence": 0.87
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("scan_id", res.body.id);
  }
}
